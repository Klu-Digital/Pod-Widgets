# Copy to deploy/.env.vps. Read by deploy/docker-compose.vps.yml only.

# --- Required ---------------------------------------------------------------
# Password for the bundled Postgres; it is never published, but still change it.
POSTGRES_PASSWORD=change-me
# Exact browser origin: scheme and host (and port if not default), no trailing slash.
PUBLIC_ORIGIN=http://203.0.113.10

# --- Edge -------------------------------------------------------------------
# :80 serves plain HTTP on the IP; a domain name makes Caddy fetch a TLS cert.
SITE_ADDRESS=:80
# With a domain, point PUBLIC_ORIGIN at https://<domain> and open 80 and 443.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Uploads (optional; run with --profile uploads) -------------------------
# Nothing uses object storage until #18. Uncomment this whole block together.
# Bucket created by minio-init.
# S3_BUCKET=pod-widgets
# MinIO login; the server uses the same pair as its S3 credentials.
# MINIO_ROOT_USER=minioadmin
# Required when the uploads profile runs; unset it and minio refuses to start.
# MINIO_ROOT_PASSWORD=change-me-too
# Host port MinIO's S3 API is published on.
# MINIO_PORT=9000
# What the browser reaches MinIO at; it is baked into presigned URLs.
# S3_PUBLIC_ENDPOINT=http://203.0.113.10:9000
# Must include S3_PUBLIC_ENDPOINT or the SPA's CSP blocks the upload.
# CSP_CONNECT_SRC=http://203.0.113.10:9000
