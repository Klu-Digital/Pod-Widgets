# Copy to `.env`. Every variable is declared and validated in
# packages/env/src/server.ts — the server refuses to start on a missing or
# malformed one rather than failing later at the first request that needed it.
# That file, not this one, is the source of truth for types and defaults.
#
# Commented-out lines are the defaults; uncomment only to change them.

# --- Required ---------------------------------------------------------------
# The single browser origin allowed to call this server with credentials. Scheme,
# host and port, no trailing slash. Testing on a phone against a LAN IP means
# adding that origin here too.
CORS_ORIGIN=http://localhost:2600

# The database. Port 4400 rather than 5432 because that is what docker-compose
# publishes — see the root .env.example for why.
DATABASE_URL=postgresql://postgres:password@localhost:4400/trumpet-pods

# --- Runtime ----------------------------------------------------------------
# PORT=1900
# One of: development | production | staging | test.
# NODE_ENV=development
# Tags every log line, so one drain can tell this process and apps/workers apart.
# SERVICE_NAME=trumpet-pods-server

# --- Observability ----------------------------------------------------------
# Logs drain to PostHog only when the key is set; otherwise they stay on stdout.
# Runtime project key used for log ingestion. Never use the CI personal key here.
# POSTHOG_PROJECT_API_KEY=phc_your-project-api-key
# POSTHOG_HOST=https://eu.i.posthog.com

# Prometheus scrape endpoint. Exposed only when BOTH are set — a path without a
# token would publish process and request metrics to anyone who guessed it.
# PROMETHEUS_METRICS_PATH=/metrics
# PROMETHEUS_METRICS_TOKEN=

# --- Object storage ---------------------------------------------------------
# Uploads are disabled unless S3_BUCKET and both credentials are set; the storage
# router then answers as if the feature is off rather than erroring.
#
# Values below target the local MinIO container (`docker compose up -d minio
# minio-init`). For AWS S3, drop S3_ENDPOINT and S3_FORCE_PATH_STYLE and set a
# real S3_REGION; for R2, keep S3_ENDPOINT with S3_REGION=auto and
# S3_FORCE_PATH_STYLE=false.
S3_BUCKET=trumpet-pods
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:5300
S3_FORCE_PATH_STYLE=true
# The host baked into presigned URLs, which is not always the host the server
# reaches the bucket at. Inside Compose the server uses http://minio:9000, a name
# that means nothing to a browser — hence the split. Defaults to S3_ENDPOINT,
# which is correct whenever the server runs outside Compose.
# S3_PUBLIC_ENDPOINT=http://localhost:5300
# 25 MiB.
# STORAGE_MAX_UPLOAD_BYTES=26214400

# --- Redis ------------------------------------------------------------------
# Optional. Unset, every rate limit counts in process memory
# instead, and `createCache()` becomes a pass-through — the
# server boots and serves normally. Local dev against `pnpm run redis:start`, which publishes 6666.
REDIS_URL=redis://localhost:6666
# Prefixes every key. Set it when several environments share one instance. Note
# this is not test isolation — the suite uses numbered logical databases.
# REDIS_KEY_PREFIX=trumpet-pods:dev:

# --- Rate limiting ----------------------------------------------------------
# How many proxies you run in front of the server: 1 for the web image's nginx,
# 2 with Traefik or a load balancer in front of it. That many entries from the
# right of `x-forwarded-for` are trusted; 0 uses the socket address. Too high
# and callers can forge their own IP. Feeds rateLimit().
# TRUSTED_PROXY_HOPS=0

# --- Job queue (pg-boss) ----------------------------------------------------
# This process is a producer: it enqueues, apps/workers runs. Both read the same
# settings, so keep them in step across the two .env files.
# PGBOSS_SCHEMA=pgboss
# QUEUE_POOL_MAX=10
# Turn off behind PgBouncer in transaction pooling mode, which cannot hold the
# session-pinned connection LISTEN needs. Polling still works either way.
# QUEUE_LISTEN_NOTIFY=true
