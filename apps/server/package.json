{
  "name": "server",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/prometheus": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "prom-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@trumpet-pods/api": "workspace:*",
    "@trumpet-pods/config": "workspace:*",
    "@trumpet-pods/db": "workspace:*",
    "@trumpet-pods/env": "workspace:*",
    "@trumpet-pods/observability": "workspace:*",
    "@trumpet-pods/redis": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
