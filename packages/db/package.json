{
  "name": "@trumpet-pods/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "post-migrate": "tsx src/dev-scripts/post-migrate/cli.ts",
    "post-migrate:run": "tsx src/dev-scripts/post-migrate/cli.ts run",
    "post-migrate:new": "tsx src/dev-scripts/post-migrate/cli.ts new",
    "post-migrate:status": "tsx src/dev-scripts/post-migrate/cli.ts status",
    "purge": "tsx src/dev-scripts/purge/cli.ts",
    "seed": "tsx src/dev-scripts/seed/cli.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@trumpet-pods/env": "workspace:*",
    "@trumpet-pods/observability": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@trumpet-pods/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "@typescript/native": "catalog:",
    "drizzle-kit": "catalog:",
    "fishery": "^2.4.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
