{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/*.gen.ts", "**/dist/**"],
  "ignoreUnresolved": ["./src/test/setup.ts"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": ["rolldown"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"],
      "ignoreIssues": {
        "src/routes/**": ["exports", "types"]
      }
    },
    "packages/api": {
      "includeEntryExports": true
    },
    "packages/storage": {
      "ignoreIssues": {
        "src/**": ["exports", "types"]
      },
      "includeEntryExports": true
    },
    "packages/ui": {
      "ignoreDependencies": ["shadcn"]
    }
  }
}
